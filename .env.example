# ══════════════════════════════════════════════════════════════
# UniPods WhatsApp Group Memory Bot — Environment Configuration
# Copy to .env and fill in all values
# ══════════════════════════════════════════════════════════════

# ── Supabase ───────────────────────────────────────────────────
# From your Supabase project settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# From your Supabase project settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ── WhatsApp Cloud API ─────────────────────────────────────────
# From Meta Developer App → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_VERIFY_TOKEN=choose-any-random-string-here
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id

# ── LLM Provider ───────────────────────────────────────────────
# Choose 'anthropic' or 'openai'
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-5

# Anthropic API key (if using Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key (if using GPT or OpenAI embeddings/Whisper)
OPENAI_API_KEY=sk-...

# ── Embeddings ─────────────────────────────────────────────────
# 'openai' uses text-embedding-3-small (requires OPENAI_API_KEY)
# 'local'  uses a local embedding server (see README)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Whisper (call transcription) ───────────────────────────────
# 'openai' uses the Whisper API (requires OPENAI_API_KEY)
# 'local'  uses a local Whisper installation
WHISPER_PROVIDER=openai
WHISPER_MODEL=whisper-1

# Directory to watch for new call recordings (manual drop)
RECORDINGS_DIR=./recordings

# ── Microsoft Teams Integration ────────────────────────────────
# Teams call recordings are automatically saved to OneDrive/SharePoint.
# The transcription service polls via Microsoft Graph API every 5 minutes.
#
# Setup (one-time, ~10 min):
#   1. Go to portal.azure.com → Azure Active Directory → App Registrations
#   2. Click "New registration" → give it a name → Register
#   3. Note the "Application (client) ID" → TEAMS_CLIENT_ID
#   4. Note the "Directory (tenant) ID" → TEAMS_TENANT_ID
#   5. Go to "Certificates & secrets" → New client secret → copy value → TEAMS_CLIENT_SECRET
#   6. Go to "API permissions" → Add:
#      - Microsoft Graph: Files.Read.All (Application)
#      - Microsoft Graph: CallRecords.Read.All (Application)
#      - Microsoft Graph: User.Read.All (Application)
#   7. Click "Grant admin consent"
#   8. TEAMS_USER_ID: go to Azure AD → Users → find the account whose OneDrive
#      holds the recordings → copy their Object ID
#      (leave blank to search org-wide SharePoint, which needs broader permissions)

TEAMS_TENANT_ID=your-azure-tenant-id
TEAMS_CLIENT_ID=your-app-client-id
TEAMS_CLIENT_SECRET=your-client-secret-value

# Object ID of the user whose OneDrive holds Teams recordings.
# Leave blank to search org-wide (requires admin-level permissions).
TEAMS_USER_ID=

# How often to poll for new recordings (milliseconds). Default: 5 minutes.
TEAMS_POLL_INTERVAL_MS=300000

# ── App Config ─────────────────────────────────────────────────
# The WhatsApp JID of the group to monitor
# Format: 123456789-1234567890@g.us (get from Baileys logs on first run)
GROUP_ID=

# Service ports
ANSWER_SERVICE_PORT=3000
SCHEDULER_PORT=3001
INGESTION_PORT=3002

# ── Feature Flags ──────────────────────────────────────────────
ENABLE_DUPLICATE_DETECTION=true
ENABLE_PROACTIVE_RECAP=true

# Cron expression for daily digest (default: 8am every day)
DIGEST_CRON=0 8 * * *

# ── Retrieval Thresholds ───────────────────────────────────────
# Minimum similarity score to include a chunk in retrieval
SIMILARITY_THRESHOLD=0.35

# Below this threshold, answer is flagged as "low confidence"
LOW_CONFIDENCE_THRESHOLD=0.5
