# ══════════════════════════════════════════════════════════════
# UniPods WhatsApp Group Memory Bot — Environment Configuration
# Copy to .env and fill in all values
# ══════════════════════════════════════════════════════════════

# ── Supabase ───────────────────────────────────────────────────
# From your Supabase project settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# From your Supabase project settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ── WhatsApp Cloud API ─────────────────────────────────────────
# From Meta Developer App → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
WHATSAPP_VERIFY_TOKEN=choose-any-random-string-here
WHATSAPP_BUSINESS_ACCOUNT_ID=your-waba-id

# ── LLM Provider ───────────────────────────────────────────────
# Choose 'anthropic' or 'openai'
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-4-5

# Anthropic API key (if using Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI API key (if using GPT or OpenAI embeddings/Whisper)
OPENAI_API_KEY=sk-...

# ── Embeddings ─────────────────────────────────────────────────
# 'openai' uses text-embedding-3-small (requires OPENAI_API_KEY)
# 'local'  uses a local embedding server (see README)
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ── Whisper (call transcription) ───────────────────────────────
# 'openai' uses the Whisper API (requires OPENAI_API_KEY)
# 'local'  uses a local Whisper installation
WHISPER_PROVIDER=openai
WHISPER_MODEL=whisper-1

# Directory to watch for new call recordings
RECORDINGS_DIR=./recordings

# ── App Config ─────────────────────────────────────────────────
# The WhatsApp JID of the group to monitor
# Format: 123456789-1234567890@g.us (get from Baileys logs on first run)
GROUP_ID=

# Service ports
ANSWER_SERVICE_PORT=3000
SCHEDULER_PORT=3001
INGESTION_PORT=3002

# ── Feature Flags ──────────────────────────────────────────────
ENABLE_DUPLICATE_DETECTION=true
ENABLE_PROACTIVE_RECAP=true

# Cron expression for daily digest (default: 8am every day)
DIGEST_CRON=0 8 * * *

# ── Retrieval Thresholds ───────────────────────────────────────
# Minimum similarity score to include a chunk in retrieval
SIMILARITY_THRESHOLD=0.35

# Below this threshold, answer is flagged as "low confidence"
LOW_CONFIDENCE_THRESHOLD=0.5
