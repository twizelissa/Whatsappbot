FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
COPY packages/shared/package*.json ./packages/shared/
COPY packages/ingestion/package*.json ./packages/ingestion/
RUN npm ci --workspace=packages/shared --workspace=packages/ingestion
COPY packages/shared ./packages/shared
COPY packages/ingestion ./packages/ingestion
RUN npm run build --workspace=packages/shared --workspace=packages/ingestion

FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/package*.json ./
COPY --from=builder /app/packages/shared ./packages/shared
COPY --from=builder /app/packages/ingestion ./packages/ingestion
COPY --from=builder /app/node_modules ./node_modules
CMD ["node", "packages/ingestion/dist/ingestion/src/index.js"]
